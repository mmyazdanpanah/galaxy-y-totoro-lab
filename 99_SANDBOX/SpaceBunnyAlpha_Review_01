su -c 'ifconfig wlan0; route -n'
su -c 'getprop | grep -i wifi'
su -c 'dumpsys wifi | head -40'

# Storage
su -c 'df -h /data /mnt/sdcard'
su -c 'stat -f /mnt/sdcard'

# Curiosity that may pay off later (USB gadget serial)
